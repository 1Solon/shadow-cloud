{
  "name": "shadow-cloud",
  "version": "0.10.1",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm run dev:web",
    "dev:web": "turbo run dev --filter=@shadow-cloud/api --filter=@shadow-cloud/bot --filter=@shadow-cloud/web",
    "dev:desktop": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "turbo run format",
    "pr": "turbo run format lint typecheck test build --continue=always",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "turbo": "2.10.4",
    "typescript": "6.0.3"
  }
}
