{
  "name": "@shadow-cloud/web",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "build": "dotenv -e ../../.env -- next build",
    "start": "dotenv -e ../../.env -- next start",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.{ts,mjs}\"",
    "lint": "eslint .",
    "typecheck": "node ./scripts/typecheck.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jose": "6.2.3",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "next-auth": "4.24.14",
    "next-themes": "0.4.6",
    "radix-ui": "^1.6.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "prettier": "3.9.4",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
