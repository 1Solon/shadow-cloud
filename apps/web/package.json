{
  "name": "@shadow-cloud/web",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "build": "dotenv -e ../../.env -- next build",
    "start": "dotenv -e ../../.env -- next start",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"browser/**/*.{ts,mjs}\" \"*.{ts,mjs}\"",
    "lint": "eslint .",
    "typecheck": "node ./scripts/typecheck.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install chromium"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jose": "6.2.12",
    "lucide-react": "1.43.0",
    "next": "16.3.4",
    "next-auth": "4.24.15",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
