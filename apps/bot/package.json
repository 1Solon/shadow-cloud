{
  "name": "@shadow-cloud/bot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" && prettier --check \"{src,test}/**/*.ts\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "14.28.1",
    "dotenv": "18.0.10"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.11",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.9",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  }
}
