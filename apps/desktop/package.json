{
  "name": "@shadow-cloud/desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/check-bundle.mjs",
    "build:native": "pnpm tauri build",
    "build:release": "pnpm tauri build --config src-tauri/tauri.release.conf.json",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.{ts,mjs}\" && cargo fmt --manifest-path src-tauri/Cargo.toml && cargo fmt --manifest-path engine/Cargo.toml",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.ts\" && node scripts/check-release.mjs",
    "test": "vitest run",
    "test:engine": "cargo test --manifest-path engine/Cargo.toml --locked"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "radix-ui": "1.6.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
