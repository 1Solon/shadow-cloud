generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum GameRole {
  ORGANIZER
  PLAYER
}

enum AuditEventType {
  GAME_CREATED
  ROSTER_UPDATED
  REGISTRATION_REQUESTED
  REGISTRATION_APPROVED
  REGISTRATION_REJECTED
  METADATA_UPDATED
  PLAYER_RESIGNED
  PLAYER_REPLACED
  TURN_SKIPPED
  TURN_ADVANCED
  TURN_REASSIGNED
  FILE_UPLOADED
  FILE_REPLACED
  FILE_DOWNLOADED
}

enum RegistrationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationDeliveryEvent {
  SAVE_UPLOADED
  SAVE_REPLACED
  GAME_INITIALIZED
  THREAD_RENAMED
  TURN_NUDGE
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  CANCELLED
}

enum TurnCompletionReason {
  SAVE_UPLOADED
  SKIPPED
  RESIGNED
  REPLACED
  REASSIGNED
}

enum GameDlcMode {
  NONE
  OCEANIA
  REPUBLICA
  BOTH
}

enum GameMode {
  TEAMS
  TEAMS_AI
  FFA
  FFA_AI
}

enum ZoneCountPreset {
  CITY_STATE
  TWO_ZONE_START
  THREE_ZONE_START
}

enum ArmyCountPreset {
  MILITIA_ONLY
  ONE_PER_ZONE
  TWO_PER_ZONE
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  displayName    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  identities     AuthIdentity[]
  organizedGames Game[]
  memberships    GamePlayer[]
  activeTurns    TurnState[]
  uploads        FileVersion[]  @relation("UploadedBy")
  replacements   FileVersion[]  @relation("ReplacedBy")
  auditEvents    AuditEvent[]   @relation("ActorEvents")
  turnRecords    TurnRecord[]
}

model AuthIdentity {
  id         String   @id @default(cuid())
  provider   String
  providerId String
  userId     String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
}

model DesktopAuthHandoff {
  id                      String    @id
  pollSecretHash          String
  approvedUserId          String?
  approvedUserEmail       String?
  approvedUserDisplayName String?
  approvedUserAvatarUrl   String?
  expiresAt               DateTime
  approvedAt              DateTime?
  consumedAt              DateTime?
  createdAt               DateTime  @default(now())

  @@index([expiresAt])
  @@index([consumedAt])
}

model Game {
  id                      String                @id @default(cuid())
  gameNumber              Int                   @unique
  name                    String
  slug                    String                @unique
  playerCount             Int?
  hasAiPlayers            Boolean?
  dlcMode                 GameDlcMode?
  gameMode                GameMode?
  techLevel               Int?
  zoneCount               ZoneCountPreset?
  armyCount               ArmyCountPreset?
  notes                   String?
  discordGuildId          String?
  discordChannelId        String?
  discordThreadId         String?               @unique
  retentionLimit          Int                   @default(5)
  turnTargetHours         Int                   @default(24)
  turnReminderGraceHours  Int                   @default(12)
  turnReminderRepeatHours Int                   @default(24)
  turnRemindersEnabled    Boolean               @default(true)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  organizerId             String
  organizer               User                  @relation(fields: [organizerId], references: [id])
  players                 GamePlayer[]
  turnState               TurnState?
  fileVersions            FileVersion[]
  auditEvents             AuditEvent[]
  registrationRequests    RegistrationRequest[]
  turnRecords             TurnRecord[]
}

model GamePlayer {
  id          String       @id @default(cuid())
  gameId      String
  userId      String?
  turnOrder   Int
  role        GameRole     @default(PLAYER)
  createdAt   DateTime     @default(now())
  game        Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  activeTurns TurnState[]  @relation("ActivePlayerEntry")
  turnRecords TurnRecord[]

  @@unique([gameId, turnOrder])
}

model TurnState {
  id                  String      @id @default(cuid())
  gameId              String      @unique
  activePlayerId      String
  activePlayerEntryId String?
  roundNumber         Int         @default(1)
  updatedAt           DateTime    @updatedAt
  game                Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  activePlayer        User        @relation(fields: [activePlayerId], references: [id])
  activePlayerEntry   GamePlayer? @relation("ActivePlayerEntry", fields: [activePlayerEntryId], references: [id])
}

model TurnRecord {
  id                     String                 @id @default(cuid())
  gameId                 String
  roundNumber            Int
  gamePlayerId           String?
  userId                 String?
  seatNumber             Int?
  playerDisplayName      String
  startedAt              DateTime
  endedAt                DateTime?
  completionReason       TurnCompletionReason?
  reminderCount          Int                    @default(0)
  lastReminderAt         DateTime?
  nextReminderAt         DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  game                   Game                   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gamePlayer             GamePlayer?            @relation(fields: [gamePlayerId], references: [id], onDelete: SetNull)
  user                   User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  notificationDeliveries NotificationDelivery[]

  @@index([gameId, endedAt, startedAt])
  @@index([endedAt, nextReminderAt])
}

model FileVersion {
  id                 String    @id @default(cuid())
  gameId             String
  uploadedById       String
  storagePath        String
  originalName       String
  versionNumber      Int
  contentHash        String?
  idempotencyKey     String?
  clientOriginalName String?
  clientFileSize     Int?
  uploadedAt         DateTime  @default(now())
  replacedAt         DateTime?
  replacedById       String?
  game               Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  uploadedBy         User      @relation("UploadedBy", fields: [uploadedById], references: [id])
  replacedBy         User?     @relation("ReplacedBy", fields: [replacedById], references: [id], onDelete: SetNull)

  @@unique([gameId, versionNumber])
  @@unique([gameId, uploadedById, idempotencyKey])
}

model RegistrationRequest {
  id                String                    @id @default(cuid())
  gameId            String
  playerDiscordId   String
  playerDisplayName String
  playerUsername    String?
  status            RegistrationRequestStatus @default(PENDING)
  discordMessageId  String?
  requestedAt       DateTime                  @default(now())
  respondedAt       DateTime?
  game              Game                      @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id        String         @id @default(cuid())
  gameId    String
  actorId   String?
  eventType AuditEventType
  payload   String
  createdAt DateTime       @default(now())
  game      Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  actor     User?          @relation("ActorEvents", fields: [actorId], references: [id])
}

model NotificationDelivery {
  id                  String                     @id @default(cuid())
  event               NotificationDeliveryEvent
  status              NotificationDeliveryStatus @default(PENDING)
  gameId              String
  gameSlug            String
  turnRecordId        String?
  payload             String
  attempts            Int                        @default(0)
  nextAttemptAt       DateTime                   @default(now())
  processingStartedAt DateTime?
  deliveredAt         DateTime?
  lastError           String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  turnRecord          TurnRecord?                @relation(fields: [turnRecordId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt, createdAt])
  @@index([turnRecordId])
}
